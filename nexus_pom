----------------------------------------------------------------------------------------
Go to .m2 folder and create file settings.xml  and add below mentioned content

nano settings.xml
Add below mentioned content into that file
Enter nexus repository username and password

<settings> 
  <servers>
        <!-- For releasing to Nexus -->
        <server>
            <id>nexus-releases</id>
            <username>your-nexus-username</username>
            <password>your-nexus-password</password>
        </server>

        <!-- For snapshot deployments -->
        <server>
            <id>nexus-snapshots</id>
            <username>your-nexus-username</username>
            <password>your-nexus-password</password>
        </server>
    </servers>
</settings>



