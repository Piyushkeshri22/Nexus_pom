Add below below-mentioned distribution management content to the file after 
</build> and before </project> 

<distributionManagement>
   <repository>
        <id>nexus-releases</id>
        <url>http://13.208.173.70:8081/repository/maven-releases/</url>    # replace this url, get it  from nexus repo
    </repository>
    <snapshotRepository>
        <id>nexus-snapshots</id>
